# Copy to .env to use (Nuxt reads .env). No secrets belong in this file: anything starting
# with VITE_ is built into the public JavaScript. NUXT_PUBLIC_MENU_URL also works at runtime.

# Optional: URL of the live menu JSON (same shape as app/data/menu.snapshot.json).
# Leave empty to use the bundled snapshot.
VITE_MENU_URL=

# QR codes (/q/<code>). Server-only: same Supabase project as the admin dashboard.
# The anon key is public by design (row-level security limits it to record_qr_scan),
# but keep it out of the repository. Unset: every QR code still redirects to /menu, uncounted.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=

# Square Online Ordering. Keep the access token server-only; never use a VITE_ prefix.
# Create a Square application and location, then test with sandbox credentials first.
NUXT_SQUARE_ACCESS_TOKEN=
NUXT_PUBLIC_SQUARE_APPLICATION_ID=
NUXT_PUBLIC_SQUARE_LOCATION_ID=
NUXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
NUXT_SQUARE_PICKUP_PREP_TIME=PT30M

# Delivery remains disabled until Square delivery beta access and merchant policy are set.
# Comma-separated postal codes and fee in cents (0 is valid if delivery is free).
NUXT_SQUARE_DELIVERY_BETA=false
NUXT_SQUARE_DELIVERY_ZIPS=
NUXT_SQUARE_DELIVERY_FEE_CENTS=
