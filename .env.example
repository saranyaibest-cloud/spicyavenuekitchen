# Copy to .env to use (Nuxt reads .env). No secrets belong in this file: anything starting
# with VITE_ is built into the public JavaScript. NUXT_PUBLIC_MENU_URL also works at runtime.

# Optional: URL of the live menu JSON (same shape as app/data/menu.snapshot.json).
# Leave empty to use the bundled snapshot.
VITE_MENU_URL=

# QR codes (/q/<code>). Server-only: same Supabase project as the admin dashboard.
# The anon key is public by design (row-level security limits it to record_qr_scan),
# but keep it out of the repository. Unset: every QR code still redirects to /menu, uncounted.
NUXT_SUPABASE_URL=
NUXT_SUPABASE_ANON_KEY=
